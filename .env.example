# ==============================================================================
# Seed-Round Agency Opportunity Finder Configuration
# ==============================================================================

# LLM Provider: "nvidia" (cloud API) or "ollama" (local / self-hosted)
LLM_PROVIDER=nvidia

# ------------------------------------------------------------------------------
# NVIDIA NIM Settings (https://build.nvidia.com/)
# ------------------------------------------------------------------------------
# Your NVIDIA API key (starts with "nvapi-...")
NVIDIA_API_KEY=your_nvidia_api_key_here

# Recommended NVIDIA Models:
# - nvidia/llama-3.1-nemotron-70b-instruct (Default: best structured reasoning)
# - meta/llama-3.3-70b-instruct            (Fast and strong B2B analysis)
# - mistralai/mistral-large-2-instruct     (Deep code and technical breakdown)
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------------------------------------------
# Ollama Settings (Local or Remote GPU server)
# ------------------------------------------------------------------------------
# Ollama endpoint (default: http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Recommended Ollama Models:
# - llama3.1:70b   (For machines with >= 48GB VRAM)
# - llama3.1:8b    (Default: lightweight for laptops / 16GB RAM)
# - qwen2.5:32b    (Great structured extraction)
OLLAMA_MODEL=llama3.1:8b

# ------------------------------------------------------------------------------
# Evaluation Pipeline Filters
# ------------------------------------------------------------------------------
# Target funding year to evaluate and rank (default: 2026)
EVAL_YEAR=2026

# Optional limit on number of companies to evaluate (leave empty to process all)
# EVAL_LIMIT=5
